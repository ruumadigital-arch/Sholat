{"code":200,"status":"OK","data":[{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6190,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6191,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6192,"text":"تَرْمِيهِمْ بِحِجَارَةٍ مِنْ سِجِّيلٍ","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6193,"text":"فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran","direction":"rtl"}},{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"Apakah kamu tidak memperhatikan bagaimana Tuhanmu telah bertindak terhadap tentara bergajah?","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6190,"text":"Bukankah Dia telah menjadikan tipu daya mereka (untuk menghancurkan Ka'bah) itu sia-sia?","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6191,"text":"dan Dia mengirimkan kapada mereka burung yang berbondong-bondong,","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6192,"text":"yang melempari mereka dengan batu (berasal) dari tanah yang terbakar,","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6193,"text":"lalu Dia menjadikan mereka seperti daun-daun yang dimakan (ulat).","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"id.indonesian","language":"id","name":"Bahasa Indonesia","englishName":"Unknown","format":"text","type":"translation","direction":"ltr"}}]}